{
  // VS Code MCP configuration for NYC city workers behind corporate proxy
  // Copy this file to .vscode/mcp.json and update with your credentials
  //
  // Prerequisites:
  // 1. Run the setup script to build the OpenGov MCP server:
  //    cd .mcp-servers/socrata-mcp-server && npm install && npm run build
  // 2. Install global-agent and copy the proxy wrapper:
  //    npm install global-agent --save
  //    copy scripts/proxy-wrapper.js .mcp-servers/socrata-mcp-server/
  // 3. Get your Socrata app token from https://data.cityofnewyork.us/profile/edit/developer_settings
  //
  // Who reads each variable: DATA_PORTAL_URL and SOCRATA_APP_TOKEN, the server;
  // NODE_TLS_REJECT_UNAUTHORIZED, Node itself; GLOBAL_AGENT_*, global-agent, which
  // proxy-wrapper.js bootstraps before it starts the server.
  //
  "servers": {
    "socrata": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/.mcp-servers/socrata-mcp-server/proxy-wrapper.js", "--stdio"],
      "env": {
        "DATA_PORTAL_URL": "https://data.cityofnewyork.us",
        "SOCRATA_APP_TOKEN": "YOUR_SOCRATA_TOKEN_HERE",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
        "GLOBAL_AGENT_HTTP_PROXY": "http://proxy.example.internal:8080",
        "GLOBAL_AGENT_HTTPS_PROXY": "http://proxy.example.internal:8080",
        "GLOBAL_AGENT_NO_PROXY": "localhost,127.0.0.1"
      }
    }
  }
}

{
  "name": "civic-ai-tools",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate-directory": "node scripts/validate-directory.mjs",
    "generate-directory-md": "node scripts/generate-directory-md.mjs",
    "migrate-directory": "node scripts/migrate-directory.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:budgets": "node scripts/check-dependency-budget.mjs",
    "check:gate-table": "node --test scripts/agents-md-gate-table.test.mjs",
    "check:budgets:self-test": "node --test scripts/check-dependency-budget.test.mjs",
    "check:skill-drift": "node scripts/check-skill-drift.mjs",
    "check:skill-drift:self-test": "node --test scripts/check-skill-drift.test.mjs",
    "check:spec-frontmatter": "node scripts/check-spec-frontmatter.mjs",
    "check:spec-frontmatter:self-test": "node --test scripts/check-spec-frontmatter.test.mjs",
    "check:spec-subtype-table": "node scripts/check-spec-subtype-table.mjs",
    "check:spec-subtype-table:self-test": "node --test scripts/check-spec-subtype-table.test.mjs",
    "check:template-env": "node scripts/check-template-env.mjs",
    "check:template-env:self-test": "node --test scripts/check-template-env.test.mjs"
  }
}

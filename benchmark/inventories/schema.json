{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "civic-inventory/1",
  "title": "A benchmark inventory (sources-at-scale design §3.2)",
  "description": "Every value is a string, an array or an object: the router's canonicalJson, which hashes an inventory, refuses numbers, booleans and null. A count is written as a string; a field with nothing to say is left out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "entries"],
  "properties": {
    "schema": { "const": "civic-inventory/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "note": { "type": "string" },
    "seed": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [{ "$ref": "#/definitions/serverEntry" }, { "$ref": "#/definitions/packEntry" }, { "$ref": "#/definitions/registryEntry" }]
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "alias": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addressVariable", "requirement"],
      "properties": {
        "addressVariable": { "$ref": "#/definitions/text" },
        "keyVariable": { "$ref": "#/definitions/text" },
        "requirement": { "enum": ["required", "optional"] },
        "defaultAddress": { "$ref": "#/definitions/text" }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "level", "names"],
      "properties": {
        "country": { "type": "string", "pattern": "^(?:[A-Z]{2}|multiple|unstated)$" },
        "level": { "enum": ["federal", "state", "local", "international", "multiple", "unstated"] },
        "names": { "type": "array", "items": { "$ref": "#/definitions/text" }, "uniqueItems": true },
        "portalDomain": { "$ref": "#/definitions/text" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "311-service-requests",
          "permits-licensing",
          "inspections",
          "public-safety",
          "housing",
          "transportation",
          "spending-contracts",
          "budget-finance",
          "payroll-workforce",
          "legislation",
          "law-rules",
          "public-notices",
          "demographics",
          "economy-labor",
          "health",
          "education",
          "environment",
          "elections",
          "property-land",
          "government-operations"
        ]
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOn"],
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "version": { "$ref": "#/definitions/text" },
        "readOn": { "$ref": "#/definitions/date" }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["none", "instance-key", "reader-sign-in"] },
        "keyIn": { "$ref": "#/definitions/text" },
        "keyVariable": { "$ref": "#/definitions/text" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addedOn", "from", "by", "sourceUrl"],
      "properties": {
        "addedOn": { "$ref": "#/definitions/date" },
        "from": { "enum": ["registry", "portal-catalog", "hand"] },
        "by": { "$ref": "#/definitions/text" },
        "sourceUrl": { "$ref": "#/definitions/text" },
        "file": { "$ref": "#/definitions/text" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "fileSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "toolsRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "toolNames", "sha256"],
      "properties": {
        "kind": { "enum": ["router-manifest", "fixture"] },
        "package": { "$ref": "#/definitions/text" },
        "sourceId": { "$ref": "#/definitions/text" },
        "path": { "$ref": "#/definitions/text" },
        "fixture": { "$ref": "#/definitions/text" },
        "toolNames": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" }, "uniqueItems": true },
        "sha256": { "$ref": "#/definitions/sha256" },
        "note": { "$ref": "#/definitions/text" }
      }
    },
    "guidanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["prompt", "embedded", "inline", "none"] },
        "fetch": { "$ref": "#/definitions/text" },
        "pinned": { "$ref": "#/definitions/text" },
        "pinnedSha256": { "$ref": "#/definitions/sha256" },
        "instructions": { "$ref": "#/definitions/text" },
        "publicationHost": { "$ref": "#/definitions/text" },
        "path": { "$ref": "#/definitions/text" },
        "blockSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "serverEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "alias",
        "sourceId",
        "displayName",
        "description",
        "freshness",
        "configuration",
        "consentDefault",
        "serverType",
        "place",
        "categories",
        "provenance",
        "toolsRef"
      ],
      "properties": {
        "kind": { "const": "server" },
        "id": { "$ref": "#/definitions/text" },
        "alias": { "$ref": "#/definitions/alias" },
        "sourceId": { "$ref": "#/definitions/text" },
        "displayName": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "freshness": { "$ref": "#/definitions/text" },
        "freshnessSource": { "$ref": "#/definitions/text" },
        "configuration": { "$ref": "#/definitions/configuration" },
        "consentDefault": { "enum": ["on", "ask-first"] },
        "publisher": { "$ref": "#/definitions/text" },
        "serverType": { "enum": ["socrata", "ckan", "arcgis", "mcp-remote", "npm-package", "custom"] },
        "place": { "$ref": "#/definitions/place" },
        "categories": { "$ref": "#/definitions/categories" },
        "registry": { "$ref": "#/definitions/registry" },
        "authentication": { "$ref": "#/definitions/authentication" },
        "licence": { "$ref": "#/definitions/text" },
        "provenance": { "$ref": "#/definitions/provenance" },
        "toolsRef": { "$ref": "#/definitions/toolsRef" },
        "guidanceRef": { "$ref": "#/definitions/guidanceRef" }
      }
    },
    "packEntry": {
      "description": "A pack (design §3.2, §4): a base server's tools with fixed arguments. Its tools are a copy of its base's (toolsRef); it carries no portal lock and no code of the base's. `hosting: container` marks a pack no instance runs (G0-5, D10). `synthetic` and `distractor` mark a constructed distractor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "alias", "sourceId", "displayName", "base", "filter", "author", "version", "place", "categories", "description", "freshness", "provenance", "toolsRef"],
      "properties": {
        "kind": { "const": "pack" },
        "alias": { "$ref": "#/definitions/alias" },
        "sourceId": { "$ref": "#/definitions/text" },
        "displayName": { "$ref": "#/definitions/text" },
        "base": { "$ref": "#/definitions/text" },
        "filter": { "type": "object", "additionalProperties": { "type": "string" } },
        "guidance": { "$ref": "#/definitions/guidanceRef" },
        "author": { "$ref": "#/definitions/text" },
        "version": { "$ref": "#/definitions/text" },
        "hash": { "$ref": "#/definitions/sha256" },
        "licence": { "$ref": "#/definitions/text" },
        "place": { "$ref": "#/definitions/place" },
        "categories": { "$ref": "#/definitions/categories" },
        "description": { "$ref": "#/definitions/text" },
        "freshness": { "$ref": "#/definitions/text" },
        "provenance": { "$ref": "#/definitions/provenance" },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "id", "datasetCount", "ownerType", "status"],
          "properties": {
            "platform": { "enum": ["socrata", "ckan"] },
            "id": { "$ref": "#/definitions/text" },
            "datasetCount": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
            "ownerType": { "$ref": "#/definitions/text" },
            "status": { "$ref": "#/definitions/text" }
          }
        },
        "hosting": { "enum": ["container"] },
        "toolsRef": { "$ref": "#/definitions/toolsRef" },
        "synthetic": { "const": "true" },
        "distractor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "of"],
          "properties": {
            "kind": { "enum": ["near-duplicate", "wrapper"] },
            "of": { "$ref": "#/definitions/alias" }
          }
        }
      },
      "dependencies": { "synthetic": ["distractor"], "distractor": ["synthetic"] }
    },
    "registryEntry": {
      "description": "An MCP Registry entry: a server whose tools were never captured. A load of it adds no tools and returns one fixed text (load-text.mjs). The registry states no place and no category.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "alias",
        "sourceId",
        "displayName",
        "description",
        "freshness",
        "configuration",
        "consentDefault",
        "serverType",
        "place",
        "categories",
        "registry",
        "provenance",
        "tools"
      ],
      "properties": {
        "kind": { "const": "server" },
        "id": { "$ref": "#/definitions/text" },
        "alias": { "$ref": "#/definitions/alias" },
        "sourceId": { "$ref": "#/definitions/text" },
        "displayName": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "freshness": { "$ref": "#/definitions/text" },
        "configuration": { "$ref": "#/definitions/configuration" },
        "consentDefault": { "enum": ["on", "ask-first"] },
        "serverType": { "enum": ["mcp-remote", "npm-package", "custom"] },
        "place": { "$ref": "#/definitions/place" },
        "categories": { "type": "array", "maxItems": 0 },
        "registry": { "$ref": "#/definitions/registry" },
        "provenance": { "$ref": "#/definitions/provenance" },
        "tools": { "const": "not-captured" }
      }
    }
  }
}

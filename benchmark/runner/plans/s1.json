    { "id": "rule-1000", "config": "rule-1000", "inventory": "benchmark/inventories/1000.json", "questions": "benchmark/questions/1000.json", "models": [], "repeats": 1 },
    { "id": "baseline-7", "config": "baseline-7", "inventory": "benchmark/inventories/7.json", "questions": "benchmark/questions/7.json", "models": ["main", "openWeight"], "repeats": 3 },

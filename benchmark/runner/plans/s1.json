    { "id": "flat-1000", "config": "flat-1000", "inventory": "benchmark/inventories/1000.json", "questions": "benchmark/questions/1000.json", "questionIds": { "draw": 50, "seed": "civic-ai-tools S1 P3 flat-1000 probe, 2026-11-03" }, "models": ["main"], "repeats": 1 }

{
  "schema": "civic-run-plan/1",
  "id": "s1",
  "description": "Sprint S1's preregistered runs (benchmark/preregistration/s1.md): the open-weight probe, the two-question probe, then the evaluations in G0-3a's order. One invocation runs one of the three; the evaluations write one run directory with every step's rows. The open-weight model is a run argument (--open-weight), fixed at G3, so this file does not change after G2.",
  "models": {
    "main": "anthropic/claude-haiku-5.5",
    "builder": "anthropic/claude-haiku-5.5",
    "openWeight": "--open-weight <slug>: one of openWeightProbe.models, chosen at G3"
  },
  "openWeightProbe": {
    "config": "baseline-7",
    "inventory": "benchmark/inventories/7.json",
    "questions": "benchmark/questions/7.json",
    "questionIds": { "from": "q01", "to": "q49" },
    "repeats": 1,
    "models": ["z-ai/glm-5.3-flash", "deepseek/deepseek-v4-flash-0731", "xiaomi/mimo-v2.6-flash"],
    "winner": "the best first-request accuracy over the offered gold; a tie goes to the model whose probe rows cost less in all; a further tie to the earlier model in this list"
  },
  "probe": {
    "questionIds": { "probeIds": 2 },
    "repeats": 1,
    "models": ["main", "openWeight"],
    "steps": [
      { "id": "probe-baseline-7", "config": "baseline-7", "inventory": "benchmark/inventories/7.json", "questions": "benchmark/questions/7.json" },
      { "id": "probe-flat-1000", "config": "flat-1000", "inventory": "benchmark/inventories/1000.json", "questions": "benchmark/questions/1000.json" }
    ],
    "calibration": "per model, the fewest characters (of the request body's JSON) per billed prompt token over the probe's requests, less 10%"
  },
  "steps": [
    { "id": "rule-50", "config": "rule-50", "inventory": "benchmark/inventories/50.json", "questions": "benchmark/questions/50.json", "models": [], "repeats": 1 },
